  "item": [
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "{\r",
              "  const loginResponse = pm.response.json();\r",
              "\r",
              "  if (pm.response.code === 200 && loginResponse.token) {\r",
              "    pm.collectionVariables.set(\"token\", loginResponse.token);\r",
              "  }\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"new.guest@example.com\",\r\n  \"password\": \"Passw0rd!\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "response": []
